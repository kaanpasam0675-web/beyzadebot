# Bu dosyayı kopyalayıp .env olarak yeniden adlandırın ve değerleri doldurun.
# Discord bot token'ınız: https://discord.com/developers/applications -> Bot sekmesi
DISCORD_TOKEN=PASTIRINIZ_BURAYA

# Dashboard (web arayüzü) giriş şifresi
DASHBOARD_PASSWORD=degistir_beni

# Dashboard'un çalışacağı port
DASHBOARD_PORT=5000

# Otomatik rol (sunucuya katılanlara verilir, boş bırakılabilir)
# AYARLAR kısmında guild id'ye göre değil, doğrudan buraya rol ADI yazılabilir.
AUTO_ROLE=